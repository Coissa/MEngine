        <mxCell id="p1-e-reg-editor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-registry" target="p1-editor-scene"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e-reg-pie" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-registry" target="p1-pie-scene"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e-scene-update" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-registry" target="p1-scene-update"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e-renderer-rhi" value="拥有" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p1-renderer" target="p1-rhi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e-rhi-backend" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-rhi" target="p1-backend"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e-backend-device" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-backend" target="p1-device"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e-device-queue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-device" target="p1-queue"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e-device-swapchain" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-device" target="p1-swapchain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e-device-frame" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-device" target="p1-frame-context"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e-device-command" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="p1-device" target="p1-command"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e-command-gpu" value="Submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p1-command" target="p1-gpu"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e-surface-swapchain" value="非拥有依赖" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;dashPattern=4 4;strokeColor=#666666;" edge="1" parent="1" source="p1-surface" target="p1-swapchain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e-world-game-scene" value="SceneHandle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;dashPattern=4 4;strokeColor=#666666;" edge="1" parent="1" source="p1-game-world" target="p1-game-scene"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e-world-editor-scene" value="SceneHandle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;dashPattern=4 4;strokeColor=#666666;" edge="1" parent="1" source="p1-editor-world" target="p1-editor-scene"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p1-e-world-pie-scene" value="SceneHandle" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;dashPattern=4 4;strokeColor=#666666;" edge="1" parent="1" source="p1-pie-world" target="p1-pie-scene"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram id="lifecycle-dataflow" name="02-启动循环与退出">
    <mxGraphModel dx="2400" dy="2200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="p2-title" value="&lt;b&gt;MEngine 完整生命周期&lt;/b&gt; — 启动 → 初始化 → 帧循环与数据传输 → 逆序退出" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=24;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2320" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="p2-main-bg" value="Main / EngineLoop（进程编排）" style="swimlane;html=1;rounded=0;startSize=38;horizontal=1;fillColor=#eef5ff;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="550" height="2040" as="geometry"/>
        </mxCell>
        <mxCell id="p2-game-bg" value="Game / Logic（Engine · WorldContext · World）" style="swimlane;html=1;rounded=0;startSize=38;horizontal=1;fillColor=#f1f8f0;strokeColor=#82b366;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="620" y="80" width="550" height="2040" as="geometry"/>
        </mxCell>
        <mxCell id="p2-render-bg" value="Render（Renderer · RenderScene）" style="swimlane;html=1;rounded=0;startSize=38;horizontal=1;fillColor=#fff7eb;strokeColor=#d79b00;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1200" y="80" width="550" height="2040" as="geometry"/>
        </mxCell>
        <mxCell id="p2-rhi-bg" value="RHI / GPU（设备与提交）" style="swimlane;html=1;rounded=0;startSize=38;horizontal=1;fillColor=#f8f3fa;strokeColor=#9673a6;fontStyle=1;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1780" y="80" width="580" height="2040" as="geometry"/>
        </mxCell>

        <mxCell id="p2-startup-label" value="启动与初始化" style="text;html=1;strokeColor=none;fillColor=#fff2cc;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="130" width="2300" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p2-main-entry" value="&lt;b&gt;main()&lt;/b&gt;&lt;br&gt;解析配置；选择 Game / Editor、平台与 RHI 后端" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="105" y="190" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="p2-create-loop" value="Create EngineLoop&lt;br&gt;建立进程级组合关系" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="105" y="290" width="420" height="60" as="geometry"/></mxCell>
        <mxCell id="p2-init-reflect" value="Reflection / TypeRegistry::Initialize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="105" y="380" width="420" height="55" as="geometry"/></mxCell>
        <mxCell id="p2-init-platform" value="PlatformApplication + Window&lt;br&gt;创建 NativeSurface，开始消息接收" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="105" y="465" width="420" height="65" as="geometry"/></mxCell>
        <mxCell id="p2-init-renderer" value="Renderer::Initialize&lt;br&gt;创建 RenderSceneRegistry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1265" y="465" width="420" height="65" as="geometry"/></mxCell>
        <mxCell id="p2-init-rhi" value="Create Backend → Adapter → Device → Queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1845" y="350" width="450" height="60" as="geometry"/></mxCell>
        <mxCell id="p2-init-swapchain" value="Create Swapchain / FrameContexts / Fences&lt;br&gt;绑定 Window NativeSurface" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1845" y="450" width="450" height="65" as="geometry"/></mxCell>
        <mxCell id="p2-init-engine" value="Engine::Initialize&lt;br&gt;GameEngine 或 EditorEngine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="685" y="560" width="420" height="65" as="geometry"/></mxCell>
        <mxCell id="p2-init-world" value="Create WorldContext(s)&lt;br&gt;Create GameInstance / World / Objects / Components" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="685" y="655" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="p2-init-scene" value="Renderer::CreateRenderScene(WorldId)&lt;br&gt;World 只保存稳定 SceneHandle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1265" y="655" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="p2-enter-run" value="EngineLoop::Run()" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="265" y="675" width="100" height="100" as="geometry"/></mxCell>

        <mxCell id="p2-loop-label" value="逐帧循环（M2 为同线程顺序阶段；目标架构可拆为 Game / Render / RHI 线程）" style="text;html=1;strokeColor=none;fillColor=#f8cecc;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="805" width="2300" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p2-pump" value="PumpMessages&lt;br&gt;读取 Close / Resize / Input" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="105" y="870" width="420" height="65" as="geometry"/></mxCell>
        <mxCell id="p2-clock" value="FrameClock + Accumulator&lt;br&gt;计算 realDelta 与 fixedStep 次数" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="105" y="965" width="420" height="65" as="geometry"/></mxCell>
        <mxCell id="p2-sim-decision" value="需要逻辑步？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="225" y="1060" width="180" height="95" as="geometry"/></mxCell>
        <mxCell id="p2-world-tick" value="&lt;b&gt;0..N × Fixed Tick&lt;/b&gt;&lt;br&gt;Engine → WorldContext → World → Object / Component&lt;br&gt;产生 dirty state 与 structural events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="675" y="1055" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="p2-extract" value="&lt;b&gt;RenderExtraction&lt;/b&gt;&lt;br&gt;逻辑步完成后读取稳定状态&lt;br&gt;结构事件可靠传递；连续状态保留最新值" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="675" y="1190" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="p2-build-submission" value="Build RenderSubmission&lt;br&gt;SceneHandle + SceneUpdateBatch + RenderFrame&lt;br&gt;附带 interpolation alpha / views / extent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="675" y="1325" width="440" height="90" as="geometry"/></mxCell>
        <mxCell id="p2-channel" value="RenderSubmissionChannel&lt;br&gt;M2：同步 move 调用&lt;br&gt;目标：有界 SPSC 队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1275" y="1325" width="400" height="90" as="geometry"/></mxCell>
        <mxCell id="p2-apply" value="RenderScene::ApplyUpdates&lt;br&gt;创建/销毁代理；更新 Transform / Camera / Light" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1275" y="1045" width="400" height="80" as="geometry"/></mxCell>
        <mxCell id="p2-prepare" value="Render Frame Update&lt;br&gt;Interpolate → Visibility / LOD → DrawLists / Passes&lt;br&gt;按渲染帧率执行，不做 Gameplay Tick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1275" y="1160" width="400" height="90" as="geometry"/></mxCell>
        <mxCell id="p2-record" value="Record CommandLists&lt;br&gt;Transitions / Clears / Draws / UI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1855" y="1060" width="430" height="70" as="geometry"/></mxCell>
        <mxCell id="p2-submit" value="Queue Submit → GPU Execute&lt;br&gt;Signal Fence → Present Swapchain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1855" y="1175" width="430" height="75" as="geometry"/></mxCell>
        <mxCell id="p2-exit-decision" value="Close / Engine Exit / Fatal？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="1"><mxGeometry x="200" y="1330" width="230" height="110" as="geometry"/></mxCell>

        <mxCell id="p2-shutdown-label" value="停止与逆序退出（Renderer 必须活到所有 World 释放 SceneHandle 之后）" style="text;html=1;strokeColor=none;fillColor=#d5e8d4;align=left;verticalAlign=middle;fontStyle=1;fontSize=18;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="1500" width="2300" height="34" as="geometry"/>
        </mxCell>
        <mxCell id="p2-stop-submit" value="Stop New Submissions&lt;br&gt;冻结帧入口" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="105" y="1570" width="420" height="60" as="geometry"/></mxCell>
        <mxCell id="p2-engine-shutdown" value="Engine::Shutdown&lt;br&gt;停止 Gameplay / PIE / World Tick" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="685" y="1570" width="420" height="65" as="geometry"/></mxCell>
        <mxCell id="p2-release-scenes" value="World(s) Release SceneHandle&lt;br&gt;销毁 WorldContext / GameInstance / World" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1"><mxGeometry x="685" y="1670" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="p2-render-stop" value="Renderer StopAccepting + Drain Queue&lt;br&gt;销毁 RenderScene / Registry 高层对象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1265" y="1670" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="p2-wait-gpu" value="Wait GPU Fences / Device Idle&lt;br&gt;确保所有在途帧结束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1845" y="1670" width="450" height="65" as="geometry"/></mxCell>
        <mxCell id="p2-destroy-rhi" value="Destroy FrameResources → Swapchain → Queue / Device → Backend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1845" y="1775" width="450" height="70" as="geometry"/></mxCell>
        <mxCell id="p2-render-done" value="Renderer::Shutdown 完成" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1265" y="1780" width="420" height="60" as="geometry"/></mxCell>
        <mxCell id="p2-platform-shutdown" value="Destroy Window / PlatformApplication&lt;br&gt;Reflection / TypeRegistry::Shutdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="105" y="1870" width="420" height="70" as="geometry"/></mxCell>
        <mxCell id="p2-destroy-loop" value="Destroy EngineLoop → return from main()" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="155" y="1980" width="320" height="70" as="geometry"/></mxCell>

        <mxCell id="p2-thread-note" value="&lt;b&gt;线程演进&lt;/b&gt;&lt;br&gt;M2：一个物理线程，按 Logic → Extraction → Render → RHI 阶段顺序执行。&lt;br&gt;目标：Game Thread 生产 RenderSubmission；Render Thread 独占 Renderer / RenderScene；RHI Thread 可选，仅负责底层提交；Worker Thread 只做纯任务，结果回交所属线程。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="620" y="1965" width="1730" height="100" as="geometry"/></mxCell>

        <mxCell id="p2-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p2-main-entry" target="p2-create-loop"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p2-create-loop" target="p2-init-reflect"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p2-init-reflect" target="p2-init-platform"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e4" value="Window / Surface ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p2-init-platform" target="p2-init-renderer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e5" value="创建 RHI" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p2-init-renderer" target="p2-init-rhi"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p2-init-rhi" target="p2-init-swapchain"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e7" value="Renderer ready" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p2-init-swapchain" target="p2-init-engine"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p2-init-engine" target="p2-init-world"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e9" value="每个 World" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p2-init-world" target="p2-init-scene"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e10" value="初始化成功" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p2-init-scene" target="p2-enter-run"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p2-enter-run" target="p2-pump"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p2-pump" target="p2-clock"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p2-clock" target="p2-sim-decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e14" value="是（可执行多次）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="p2-sim-decision" target="p2-world-tick"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="p2-e15" value="逻辑帧完成" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#b85450;strokeWidth=2;" edge="1" parent="1" source="p2-world-tick" target="p2-extract"><mxGeometry relative="1" as="geometry"/></mxCell>
