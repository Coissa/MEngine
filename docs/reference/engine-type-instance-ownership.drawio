        <mxCell id="te-loop-renderer" value="1 × unique_ptr&lt;Renderer&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=diamondThin;endFill=1;strokeWidth=2;" edge="1" parent="1" source="t-loop" target="t-renderer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="te-game-inherit" value="is-a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=0;strokeColor=#2e7d32;strokeWidth=2;" edge="1" parent="1" source="t-game-engine" target="t-engine"><mxGeometry relative="1" as="geometry"/></mxCell>
