        <mxCell id="te-context-gameinst" value="0..1 × unique_ptr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=diamondThin;endFill=1;strokeWidth=2;" edge="1" parent="1" source="t-context" target="t-game-instance"><mxGeometry relative="1" as="geometry"/></mxCell>
