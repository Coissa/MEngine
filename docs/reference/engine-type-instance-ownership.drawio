        <mxCell id="t-platform" value="&lt;b&gt;IPlatformApplication&lt;/b&gt;&lt;br&gt;PumpMessages / Input / Window events" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="85" y="520" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="t-window" value="&lt;b&gt;Window&lt;/b&gt;&lt;br&gt;NativeHandle / Extent / Close state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="85" y="640" width="330" height="70" as="geometry"/></mxCell>
        <mxCell id="t-clock" value="&lt;b&gt;FrameClock&lt;/b&gt;&lt;br&gt;realDelta / accumulator / fixedStep" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="85" y="760" width="330" height="70" as="geometry"/></mxCell>

        <mxCell id="t-engine" value="&lt;b&gt;Engine（abstract）&lt;/b&gt;&lt;br&gt;Initialize / FixedTick / Shutdown&lt;br&gt;拥有 1..N 个 WorldContext" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="670" y="380" width="380" height="90" as="geometry"/></mxCell>
        <mxCell id="t-game-engine" value="&lt;b&gt;GameEngine&lt;/b&gt;&lt;br&gt;运行游戏" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="520" width="270" height="60" as="geometry"/></mxCell>
        <mxCell id="t-editor-engine" value="&lt;b&gt;EditorEngine&lt;/b&gt;&lt;br&gt;Editor World + 0..N PIE Worlds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="520" width="270" height="60" as="geometry"/></mxCell>
        <mxCell id="t-context" value="&lt;b&gt;WorldContext&lt;/b&gt;&lt;br&gt;WorldType / Lifecycle state / SceneHandle&lt;br&gt;拥有恰好一个 World；可拥有 GameInstance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf5e9;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="640" width="420" height="90" as="geometry"/></mxCell>
        <mxCell id="t-game-instance" value="&lt;b&gt;GameInstance&lt;/b&gt;&lt;br&gt;游戏会话级对象&lt;br&gt;属于 Game / PIE Context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="800" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="t-world" value="&lt;b&gt;World&lt;/b&gt;&lt;br&gt;逻辑世界、对象集合与 Tick&lt;br&gt;仅保存 RenderSceneHandle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="810" y="800" width="280" height="80" as="geometry"/></mxCell>
        <mxCell id="t-object" value="&lt;b&gt;Object / Entity&lt;/b&gt;&lt;br&gt;0..N per World" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="950" width="230" height="65" as="geometry"/></mxCell>
        <mxCell id="t-component" value="&lt;b&gt;Component&lt;/b&gt;&lt;br&gt;0..N per Object" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="930" y="950" width="230" height="65" as="geometry"/></mxCell>
        <mxCell id="t-extraction" value="&lt;b&gt;RenderExtraction&lt;/b&gt;&lt;br&gt;将 World 状态复制为渲染值对象&lt;br&gt;不转移、不共享 World 所有权" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="650" y="1080" width="510" height="85" as="geometry"/></mxCell>

        <mxCell id="t-renderer" value="&lt;b&gt;Renderer&lt;/b&gt;&lt;br&gt;Render Thread 门面与唯一渲染所有者&lt;br&gt;拥有 RenderSceneRegistry、RHI 与帧资源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1395" y="380" width="400" height="90" as="geometry"/></mxCell>
        <mxCell id="t-scene-reg" value="&lt;b&gt;RenderSceneRegistry&lt;/b&gt;&lt;br&gt;SceneHandle → RenderScene&lt;br&gt;集中分配、查询与销毁 Scene" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1315" y="540" width="300" height="85" as="geometry"/></mxCell>
        <mxCell id="t-channel" value="&lt;b&gt;RenderSubmissionChannel&lt;/b&gt;&lt;br&gt;同步 move 或有界 SPSC Queue&lt;br&gt;通道拥有排队中的值对象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1580" y="1040" width="300" height="90" as="geometry"/></mxCell>
        <mxCell id="t-scene" value="&lt;b&gt;RenderScene&lt;/b&gt;&lt;br&gt;每个 World 对应一个&lt;br&gt;仅含渲染代理与渲染所需状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5e6;strokeColor=#d79b00;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="700" width="290" height="85" as="geometry"/></mxCell>
        <mxCell id="t-proxy" value="&lt;b&gt;RenderProxy / ScenePrimitive&lt;/b&gt;&lt;br&gt;0..N per RenderScene&lt;br&gt;不反向持有 Object / Component" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5e6;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="850" width="290" height="80" as="geometry"/></mxCell>
        <mxCell id="t-submission" value="&lt;b&gt;RenderSubmission（value）&lt;/b&gt;&lt;br&gt;SceneHandle&lt;br&gt;SceneUpdateBatch + RenderFrame" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1320" y="1040" width="230" height="90" as="geometry"/></mxCell>

        <mxCell id="t-rhi" value="&lt;b&gt;IRHIBackend&lt;/b&gt;&lt;br&gt;D3D12 / Vulkan / ..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1990" y="390" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="t-adapter" value="Adapter" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1990" y="520" width="140" height="55" as="geometry"/></mxCell>
        <mxCell id="t-device" value="Device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2170" y="520" width="140" height="55" as="geometry"/></mxCell>
        <mxCell id="t-queue" value="CommandQueue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eaf7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1990" y="650" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="t-swapchain" value="Swapchain" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eaf7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2160" y="650" width="150" height="55" as="geometry"/></mxCell>
        <mxCell id="t-frame-context" value="FrameContext[2..N]&lt;br&gt;Allocator / Fence / Resources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eaf7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1990" y="770" width="320" height="70" as="geometry"/></mxCell>
        <mxCell id="t-command" value="CommandList / Pipeline / Buffer / Texture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eaf7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1990" y="900" width="320" height="65" as="geometry"/></mxCell>
        <mxCell id="t-gpu" value="&lt;b&gt;GPU execution&lt;/b&gt;&lt;br&gt;in-flight lifetime 由 Fence 约束" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1990" y="1030" width="320" height="70" as="geometry"/></mxCell>

        <mxCell id="t-note" value="&lt;b&gt;所有权规则&lt;/b&gt;&lt;br&gt;• 独占资源优先使用值成员或 std::unique_ptr；容器拥有元素时使用拥有型容器。&lt;br&gt;• 跨域关系使用稳定 ID / Handle；World 不持有 RenderScene 指针，RenderScene 不持有 World / Object 指针。&lt;br&gt;• RenderSubmission 是一次性移动的值对象；可靠结构命令不能丢，连续状态可以覆盖为最新快照。&lt;br&gt;• 原生窗口句柄只作为 Swapchain 创建依赖，不转移 Window 所有权。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=12;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="480" y="1280" width="1440" height="180" as="geometry"/></mxCell>
        <mxCell id="t-legend" value="&lt;b&gt;图例&lt;/b&gt;&lt;br&gt;黑色实线：独占所有权 / 生命周期包含&lt;br&gt;绿色空心箭头：继承 / 实现&lt;br&gt;红色虚线：值数据移动&lt;br&gt;灰色虚线：Handle / 非拥有引用&lt;br&gt;边上 1、0..N、1..N：实例数量" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1940" y="1280" width="420" height="180" as="geometry"/></mxCell>

        <mxCell id="te-main-loop" value="1 × unique ownership" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;" edge="1" parent="1" source="t-main" target="t-loop"><mxGeometry relative="1" as="geometry"/></mxCell>
