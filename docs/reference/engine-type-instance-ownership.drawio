        <mxCell id="t-render-bg" value="渲染域类型（Render Thread 所属）" style="swimlane;html=1;rounded=0;startSize=34;horizontal=1;fillColor=#fff8ef;strokeColor=#d79b00;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1270" y="315" width="650" height="930" as="geometry"/></mxCell>
        <mxCell id="t-rhi-bg" value="RHI / GPU 类型" style="swimlane;html=1;rounded=0;startSize=34;horizontal=1;fillColor=#faf7fc;strokeColor=#9673a6;fontStyle=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1940" y="315" width="420" height="930" as="geometry"/></mxCell>

