        <mxCell id="te-channel-renderer" value="move / dequeue" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;dashed=1;dashPattern=8 8;strokeColor=#b85450;strokeWidth=3;" edge="1" parent="1" source="t-channel" target="t-renderer"><mxGeometry relative="1" as="geometry"/></mxCell>
