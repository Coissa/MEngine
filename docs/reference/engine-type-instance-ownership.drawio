        <mxCell id="te-loop-platform" value="1 × unique_ptr" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=diamondThin;endFill=1;strokeWidth=2;" edge="1" parent="1" source="t-loop" target="t-platform"><mxGeometry relative="1" as="geometry"/></mxCell>
